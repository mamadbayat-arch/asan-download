{
  "manifest_version": 3,
  "name": "آسان دانلود — نسخهٔ Gopeed",
  "version": "1.8.0",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "intent.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon128.png"
  },
  "icons": {
    "128": "icon128.png"
  }
}
