# Only application sources and build inputs belong in this repository.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/RELEASE-*.md
!/*.cs
!/Build.ps1
!/BuildRelease.ps1
!/Install.cmd
!/Test.ps1
!/TestUpdates.ps1
!/AdaptiveServer.mjs
!/TestServer.js
!/UpdateFixtureServer.mjs
!/NativeSmoke.mjs
!/VerifyFinalSite.mjs
!/Assets/
!/BrowserExtension/
!/server/
!/Release/
/Release/*
!/Release/Install.cmd
/HistoryProbe.cs

# Credentials, signing keys and user/runtime data must never be committed.
**/.env
**/.env.*
**/ADMIN-ACCESS.txt
**/Admin-access.txt
**/UPDATE-SIGNING-KEY.xml
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/session.json*
**/session-*.json
**/*.history/
/server/data/
/server/test-data-*/
/server/public/downloads/
**/node_modules/
**/__pycache__/
*.pyc
*.exe
*.dll
*.zip
*.tar.gz
*.log
*.tmp
*.bak

# Generated site preview/build copies.
/server/public/release.json
